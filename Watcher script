# Watcher - Step 3: watches the Helpers folder for request folders (values in the folder name) and runs the requested action
#   UpdateAA__User__Client__Date(M-D-YYYY)__ReportType__Timestamp
#   AccessRefresh__User__Timestamp

$AccessDatabasePath = "C:\Path\To\Your\Database.accdb"   # <-- Update this path

Add-Type -AssemblyName Microsoft.VisualBasic

# Reads a single Variable Value from the Access Settings table
function Get-Setting {
    param([string]$Name)

    $value = $null
    $connection = $null
    $recordset = $null

    try {
        $connection = New-Object -ComObject ADODB.Connection
        $recordset  = New-Object -ComObject ADODB.Recordset

        $connection.Open("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=$AccessDatabasePath")
        $recordset.Open("SELECT [Variable Value] FROM [Settings] WHERE [Variable Name]='$Name'", $connection)

        if (-not $recordset.EOF) {
            $value = [string]$recordset.Fields.Item("Variable Value").Value
        }
    }
    catch {
        Write-Host ("Error reading Settings ({0}): {1}" -f $Name, $_.Exception.Message)
    }
    finally {
        try { if ($recordset -and $recordset.State -eq 1) { $recordset.Close() } } catch {}
        try { if ($connection -and $connection.State -eq 1) { $connection.Close() } } catch {}

        if ($recordset)  { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($recordset) | Out-Null } catch {} }
        if ($connection) { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($connection) | Out-Null } catch {} }
    }

    return $value
}

# Shows a line in the console and appends it to the request's output file
function Write-RunLine {
    param([string]$OutputPath, [string]$Line)

    Write-Host $Line
    Add-Content -Path $OutputPath -Value $Line -Encoding UTF8
}

# Returns the request time from the folder name's last part (yyyyMMdd-HHmmss), or $null if the name doesn't match the pattern
function Get-RequestTime {
    param([string]$FolderName)

    $parts = $FolderName -split '__'
    if ($parts.Count -lt 3) {
        return $null
    }

    try {
        return [datetime]::ParseExact($parts[-1], 'yyyyMMdd-HHmmss', $null)
    }
    catch {
        return $null
    }
}

# Reads every column of the Quarterly and Monthly Report Data tables (plain SELECT, works with Access open),
# writes them as text to a temporary workbook, then replaces the client data workbook only if that succeeded
function Invoke-AccessRefresh {
    param([string]$OutputPath)

    if ([string]::IsNullOrWhiteSpace($clientDataPath)) {
        Write-RunLine $OutputPath "ERROR: WATCHER CLIENT DATA PATH IS BLANK IN SETTINGS"
        return
    }

    $tables = [ordered]@{
        'Quarterly' = 'Report Data - Quarterly'
        'Monthly'   = 'Report Data - Monthly'
    }

    $tempPath   = Join-Path $env:TEMP ("ReportDataCopy_{0}.xlsx" -f [guid]::NewGuid().ToString('N'))
    $accessConn = $null
    $excelConn  = $null
    $recordset  = $null
    $exported   = $false

    try {
        $accessConn = New-Object -ComObject ADODB.Connection
        $accessConn.Open("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=$AccessDatabasePath")

        $excelConn = New-Object -ComObject ADODB.Connection
        $excelConn.Open("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=$tempPath;Extended Properties=`"Excel 12.0 Xml;HDR=YES`"")

        foreach ($sheet in $tables.Keys) {
            $recordset = New-Object -ComObject ADODB.Recordset
            $recordset.Open("SELECT * FROM [$($tables[$sheet])]", $accessConn)

            $fieldNames = @(foreach ($field in $recordset.Fields) { $field.Name })
            $columnDefs = ($fieldNames | ForEach-Object { "[{0}] MEMO" -f $_ }) -join ', '
            $columnList = ($fieldNames | ForEach-Object { "[{0}]" -f $_ }) -join ', '

            $excelConn.Execute("CREATE TABLE [$sheet] ($columnDefs)") | Out-Null

            while (-not $recordset.EOF) {
                $values = foreach ($name in $fieldNames) {
                    $value = $recordset.Fields.Item($name).Value
                    if ($null -eq $value -or $value -is [System.DBNull]) {
                        "''"
                    }
                    else {
                        "'" + ([string]$value).Replace("'", "''") + "'"
                    }
                }

                $excelConn.Execute("INSERT INTO [$sheet] ($columnList) VALUES ($($values -join ', '))") | Out-Null
                $recordset.MoveNext()
            }

            $recordset.Close()
        }

        $exported = $true
    }
    catch {
        Write-RunLine $OutputPath ("ERROR: CLIENT DATA REFRESH FAILED (EXISTING COPY LEFT UNCHANGED): {0}" -f $_.Exception.Message)
    }
    finally {
        try { if ($recordset -and $recordset.State -eq 1) { $recordset.Close() } } catch {}
        try { if ($excelConn -and $excelConn.State -eq 1) { $excelConn.Close() } } catch {}
        try { if ($accessConn -and $accessConn.State -eq 1) { $accessConn.Close() } } catch {}

        if ($recordset)  { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($recordset) | Out-Null } catch {} }
        if ($excelConn)  { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($excelConn) | Out-Null } catch {} }
        if ($accessConn) { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($accessConn) | Out-Null } catch {} }
    }

    if (-not $exported) {
        Remove-Item -Path $tempPath -ErrorAction SilentlyContinue
        return
    }

    try {
        if (Test-Path $clientDataPath) {
            [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile($clientDataPath, 'OnlyErrorDialogs', 'DeletePermanently')
        }
        Move-Item -Path $tempPath -Destination $clientDataPath -ErrorAction Stop
        Write-RunLine $OutputPath ("Client data refreshed: {0}" -f $clientDataPath)
    }
    catch {
        Write-RunLine $OutputPath ("ERROR: COULD NOT REPLACE CLIENT DATA FILE (IS IT OPEN?): {0}" -f $_.Exception.Message)
        Remove-Item -Path $tempPath -ErrorAction SilentlyContinue
    }
}

# Runs Update AA for one client
function Invoke-UpdateAA {
    param([string]$OutputPath, [string[]]$Parts)

    if ($Parts.Count -ne 6) {
        Write-RunLine $OutputPath ("ERROR: REQUEST FOLDER NAME DOES NOT MATCH UpdateAA__User__Client__Date__ReportType__Timestamp: {0}" -f ($Parts -join '__'))
        return
    }

    $client     = $Parts[2]
    $date       = $Parts[3] -replace '-', '/'
    $reportType = $Parts[4]

    if ([string]::IsNullOrWhiteSpace($client)) {
        Write-RunLine $OutputPath "ERROR: NO CLIENT NAME IN REQUEST"
        return
    }

    try {
        [datetime]::ParseExact($date, 'M/d/yyyy', $null) | Out-Null
    }
    catch {
        Write-RunLine $OutputPath ("ERROR: INVALID DATE (EXPECTED M-D-YYYY): {0}" -f $Parts[3])
        return
    }

    if ($reportType -notin @('Quarterly', 'Monthly')) {
        Write-RunLine $OutputPath ("ERROR: INVALID REPORT TYPE (EXPECTED QUARTERLY OR MONTHLY): {0}" -f $reportType)
        return
    }

    $clientArg = $client.Replace("'", "''")
    $psCmd = "& '$updateAAScriptPath' -AccessDatabasePath '$AccessDatabasePath' -DateNewReport '$date' -ClientNames '$clientArg' -ReportType '$reportType' 2>&1"

    & powershell.exe -NoProfile -ExecutionPolicy Bypass -Command $psCmd 2>&1 | ForEach-Object {
        Write-RunLine $OutputPath ([string]$_)
    }
}

# Runs the request named by the folder, then removes the folder
# (the result file, written first, keeps a request from running twice even if the folder can't be removed)
function Invoke-Request {
    param([string]$FolderPath)

    $folderName = Split-Path -Path $FolderPath -Leaf
    $outputPath = Join-Path $helperFolder ($folderName + '_result.txt')

    Write-RunLine $outputPath ("Request started: {0}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"))

    $parts = $folderName -split '__'

    switch ($parts[0]) {
        'UpdateAA'      { Invoke-UpdateAA -OutputPath $outputPath -Parts $parts }
        'AccessRefresh' {
            if ($parts.Count -ne 3) {
                Write-RunLine $outputPath ("ERROR: REQUEST FOLDER NAME DOES NOT MATCH AccessRefresh__User__Timestamp: {0}" -f $folderName)
            }
            else {
                Invoke-AccessRefresh -OutputPath $outputPath
            }
        }
        default         { Write-RunLine $outputPath ("ERROR: UNKNOWN ACTION: {0}" -f $parts[0]) }
    }

    try {
        [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteDirectory($FolderPath, 'OnlyErrorDialogs', 'DeletePermanently')
    }
    catch {
        Write-RunLine $outputPath ("ERROR: COULD NOT DELETE REQUEST FOLDER (DELETE IT MANUALLY): {0} ({1})" -f $folderName, $_.Exception.Message)
    }
}

$updateAAScriptPath = Get-Setting 'Interface Button Update AA'
$helperFolder       = Get-Setting 'Watcher Helper'
$clientDataPath     = Get-Setting 'Watcher Client Data'

if ([string]::IsNullOrWhiteSpace($updateAAScriptPath) -or -not (Test-Path $updateAAScriptPath)) {
    Write-Host "Update AA script path is blank or not found: $updateAAScriptPath"
    exit
}

if ([string]::IsNullOrWhiteSpace($helperFolder) -or -not (Test-Path $helperFolder)) {
    Write-Host "Watcher Helper folder is blank or not found: $helperFolder"
    exit
}

$watcherStart = Get-Date

Write-Host "Watching $helperFolder for requests. Press Stop to end."

while ($true) {
    $requestFolders = Get-ChildItem -Path $helperFolder -Directory |
        Where-Object {
            $requestTime = Get-RequestTime $_.Name
            $requestTime -and
            $requestTime -ge $watcherStart -and
            -not (Test-Path (Join-Path $helperFolder ($_.Name + '_result.txt')))
        } |
        Sort-Object CreationTime

    foreach ($folder in $requestFolders) {
        Write-Host ("Found folder: {0}" -f $folder.Name)
        Start-Sleep -Seconds 0   # Troubleshooting delay: raise to give time to rename a hand-made request folder before it's handled
        if (Test-Path $folder.FullName) {
            Write-Host ("Handling request: {0}" -f $folder.Name)
            Invoke-Request -FolderPath $folder.FullName
        }
    }

    Start-Sleep -Seconds 1   # Checks the Helpers folder for new requests about once a second
}
