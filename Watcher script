# Watcher - Step 3: watches the Helpers folder for request folders (values in the folder name) and runs Update AA

$AccessDatabasePath = "C:\Path\To\Your\Database.accdb"   # <-- Update this path

# Reads a single Variable Value from the Access Settings table
function Get-Setting {
    param([string]$Name)

    $value = $null
    $connection = $null
    $recordset = $null

    try {
        $connection = New-Object -ComObject ADODB.Connection
        $recordset  = New-Object -ComObject ADODB.Recordset

        $connection.Open("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=$AccessDatabasePath")
        $recordset.Open("SELECT [Variable Value] FROM [Settings] WHERE [Variable Name]='$Name'", $connection)

        if (-not $recordset.EOF) {
            $value = [string]$recordset.Fields.Item("Variable Value").Value
        }
    }
    catch {
        Write-Host ("Error reading Settings ({0}): {1}" -f $Name, $_.Exception.Message)
    }
    finally {
        try { if ($recordset -and $recordset.State -eq 1) { $recordset.Close() } } catch {}
        try { if ($connection -and $connection.State -eq 1) { $connection.Close() } } catch {}

        if ($recordset)  { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($recordset) | Out-Null } catch {} }
        if ($connection) { try { [System.Runtime.InteropServices.Marshal]::ReleaseComObject($connection) | Out-Null } catch {} }
    }

    return $value
}

# Shows a line in the console and appends it to the request's output file
function Write-RunLine {
    param([string]$OutputPath, [string]$Line)

    Write-Host $Line
    Add-Content -Path $OutputPath -Value $Line -Encoding UTF8
}

# Reads one request folder's name, removes the folder, validates its values, and runs the requested action
# Folder name pattern: Action__User__Client__Date(M-D-YYYY)__ReportType__Timestamp
function Invoke-Request {
    param([string]$FolderPath)

    $folderName = Split-Path -Path $FolderPath -Leaf
    $outputPath = Join-Path $helperFolder ($folderName + '_result.txt')

    try {
        [System.IO.Directory]::Delete($FolderPath)
    }
    catch {}

    if (Test-Path $FolderPath) {
        Write-RunLine $outputPath ("ERROR: COULD NOT DELETE REQUEST FOLDER - WATCHER STOPPED: {0}" -f $folderName)
        exit
    }

    $parts = $folderName -split '__'

    if ($parts.Count -ne 6) {
        Write-RunLine $outputPath ("ERROR: REQUEST FOLDER NAME DOES NOT MATCH Action__User__Client__Date__ReportType__Timestamp: {0}" -f $folderName)
        return
    }

    $action     = $parts[0]
    $client     = $parts[2]
    $date       = $parts[3] -replace '-', '/'
    $reportType = $parts[4]

    if ($action -ne 'UpdateAA') {
        Write-RunLine $outputPath ("ERROR: UNKNOWN ACTION: {0}" -f $action)
        return
    }

    if ([string]::IsNullOrWhiteSpace($client)) {
        Write-RunLine $outputPath "ERROR: NO CLIENT NAME IN REQUEST"
        return
    }

    try {
        [datetime]::ParseExact($date, 'M/d/yyyy', $null) | Out-Null
    }
    catch {
        Write-RunLine $outputPath ("ERROR: INVALID DATE (EXPECTED M-D-YYYY): {0}" -f $parts[3])
        return
    }

    if ($reportType -notin @('Quarterly', 'Monthly')) {
        Write-RunLine $outputPath ("ERROR: INVALID REPORT TYPE (EXPECTED QUARTERLY OR MONTHLY): {0}" -f $reportType)
        return
    }

    $clientArg = $client.Replace("'", "''")
    $psCmd = "& '$updateAAScriptPath' -AccessDatabasePath '$AccessDatabasePath' -DateNewReport '$date' -ClientNames '$clientArg' -ReportType '$reportType' 2>&1"

    & powershell.exe -NoProfile -ExecutionPolicy Bypass -Command $psCmd 2>&1 | ForEach-Object {
        Write-RunLine $outputPath ([string]$_)
    }
}

$updateAAScriptPath = Get-Setting 'Interface Button Update AA'
$helperFolder       = Get-Setting 'Watcher Helper'

if ([string]::IsNullOrWhiteSpace($updateAAScriptPath) -or -not (Test-Path $updateAAScriptPath)) {
    Write-Host "Update AA script path is blank or not found: $updateAAScriptPath"
    exit
}

if ([string]::IsNullOrWhiteSpace($helperFolder) -or -not (Test-Path $helperFolder)) {
    Write-Host "Watcher Helper folder is blank or not found: $helperFolder"
    exit
}

$watcher = New-Object System.IO.FileSystemWatcher $helperFolder
$watcher.NotifyFilter = [System.IO.NotifyFilters]::DirectoryName

Write-Host "Watching $helperFolder for requests. Press Stop to end."

while ($true) {
    $requestFolders = Get-ChildItem -Path $helperFolder -Directory |
        Where-Object { -not (Get-ChildItem -Path $_.FullName -Force) } |
        Sort-Object CreationTime

    foreach ($folder in $requestFolders) {
        Write-Host ("Found folder: {0} - waiting 15 seconds" -f $folder.Name)
        Start-Sleep -Seconds 15
        if (Test-Path $folder.FullName) {
            Write-Host ("Handling request: {0}" -f $folder.Name)
            Invoke-Request -FolderPath $folder.FullName
        }
    }

    $watcher.WaitForChanged([System.IO.WatcherChangeTypes]::Created, 1000) | Out-Null
}
